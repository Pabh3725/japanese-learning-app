--- /dev/null
+++ b/scripts/seed/db.ts
@@ -0,0 +1,72 @@
+// SeedDb thật, dùng supabase-js với SERVICE ROLE key (bỏ qua RLS).
+// Chỉ được import từ script chạy ở terminal, không bao giờ từ app Next.js.
+
+import { createClient } from '@supabase/supabase-js'
+import type { Row, SeedDb } from './run'
+
+const PAGE = 1000 // PostgREST trả tối đa 1000 dòng mỗi lần
+const CHUNK = 500 // gửi upsert theo lô
+
+export function createSupabaseSeedDb(url: string, serviceRoleKey: string): SeedDb {
+  const sb = createClient(url, serviceRoleKey, {
+    auth: { persistSession: false, autoRefreshToken: false },
+  })
+
+  return {
+    async fetchAll(table, columns) {
+      const out: Row[] = []
+      for (let from = 0; ; from += PAGE) {
+        const { data, error } = await sb
+          .from(table)
+          .select(columns.join(','))
+          .order(columns[0])
+          .order(columns[1] ?? columns[0]) // thứ tự cố định để chia trang không sót dòng
+          .range(from, from + PAGE - 1)
+        if (error) throw new Error(`Đọc ${table} lỗi: ${error.message}`)
+        const rows = (data ?? []) as unknown as Row[]
+        out.push(...rows)
+        if (rows.length < PAGE) return out
+      }
+    },
+
+    async upsert(table, rows, onConflict) {
+      for (let i = 0; i < rows.length; i += CHUNK) {
+        const { error } = await sb.from(table).upsert(rows.slice(i, i + CHUNK), { onConflict })
+        if (error) throw new Error(`Ghi ${table} lỗi: ${error.message}${error.details ? ` (${error.details})` : ''}`)
+      }
+    },
+
+    async deleteLinks(links) {
+      for (const l of links) {
+        const { error } = await sb
+          .from('vocabulary_kanji')
+          .delete()
+          .eq('vocabulary_id', l.vocabulary_id)
+          .eq('position', l.position)
+        if (error) throw new Error(`Xoá liên kết thừa lỗi: ${error.message}`)
+      }
+    },
+  }
+}
+
+/**
+ * Chặn dùng nhầm anon/publishable key: key đó không ghi được (RLS chặn) và nếu
+ * ai đó lỡ dán service key vào biến NEXT_PUBLIC_ thì càng phải phát hiện sớm.
+ */
+export function assertServiceRoleKey(key: string): void {
+  if (key.startsWith('sb_publishable_')) {
+    throw new Error('SUPABASE_SERVICE_ROLE_KEY đang là publishable key. Cần secret key (sb_secret_...) hoặc service_role key.')
+  }
+  if (key.startsWith('sb_secret_')) return
+  const payload = key.split('.')[1]
+  if (!payload) throw new Error('SUPABASE_SERVICE_ROLE_KEY không đúng định dạng.')
+  try {
+    const role = JSON.parse(Buffer.from(payload, 'base64url').toString('utf8')).role
+    if (role !== 'service_role') {
+      throw new Error(`SUPABASE_SERVICE_ROLE_KEY có role "${role}", cần "service_role" (đây có thể là anon key).`)
+    }
+  } catch (e) {
+    if (e instanceof SyntaxError) throw new Error('SUPABASE_SERVICE_ROLE_KEY không đúng định dạng.')
+    throw e
+  }
+}
diff --git a/scripts/seed/plan.ts b/scripts/seed/plan.ts
new file mode 100644
index 0000000..3a19a98
--- /dev/null
+++ b/scripts/seed/plan.ts
@@ -0,0 +1,73 @@
+// So data trong file với data đang có trong DB → kế hoạch ghi.
+// Hàm thuần, không gọi DB. Đây là nội dung của báo cáo dry-run.
+
+export interface RowChange<T> {
+  key: string
+  row: T
+  /** Các cột khác với DB; rỗng nghĩa là dòng mới. */
+  changedColumns: string[]
+}
+
+export interface TablePlan<T> {
+  inserts: RowChange<T>[]
+  updates: RowChange<T>[]
+  unchanged: number
+  /** Có trong DB nhưng không còn trong file. Seed KHÔNG xoá (data-spec §1.4). */
+  missingInFile: string[]
+}
+
+function same(a: unknown, b: unknown): boolean {
+  if (Array.isArray(a) || Array.isArray(b)) return JSON.stringify(a ?? null) === JSON.stringify(b ?? null)
+  return (a ?? null) === (b ?? null)
+}
+
+/**
+ * @param desired  dòng từ file
+ * @param existing dòng đang có trong DB
+ * @param keyOf    khoá ổn định (code, character...)
+ * @param columns  các cột cần so sánh và ghi
+ */
+export function planTable<T extends Record<string, unknown>>(
+  desired: T[],
+  existing: Record<string, unknown>[],
+  keyOf: (row: Record<string, unknown>) => string,
+  columns: readonly (keyof T & string)[],
+): TablePlan<T> {
+  const existingByKey = new Map(existing.map((r) => [keyOf(r), r]))
+  const desiredKeys = new Set<string>()
+  const plan: TablePlan<T> = { inserts: [], updates: [], unchanged: 0, missingInFile: [] }
+
+  for (const row of desired) {
+    const key = keyOf(row)
+    desiredKeys.add(key)
+    const current = existingByKey.get(key)
+    if (!current) {
+      plan.inserts.push({ key, row, changedColumns: [] })
+      continue
+    }
+    const changedColumns = columns.filter((c) => !same(row[c], current[c]))
+    if (changedColumns.length === 0) plan.unchanged++
+    else plan.updates.push({ key, row, changedColumns })
+  }
+
+  for (const key of existingByKey.keys()) {
+    if (!desiredKeys.has(key)) plan.missingInFile.push(key)
+  }
+  return plan
+}
+
+export function isEmpty(plan: TablePlan<unknown>): boolean {
+  return plan.inserts.length === 0 && plan.updates.length === 0
+}
+
+/**
+ * sort_order là UNIQUE và Postgres kiểm tra từng dòng ngay lúc ghi. Đổi chỗ hai từ
+ * (A lấy số cũ của B) sẽ bị từ chối nếu ghi thẳng. Cách làm: bước 1 chuyển mọi dòng
+ * có sort_order thay đổi sang số tạm TEMP_SORT_OFFSET + số mới (không thể trùng),
+ * bước 2 ghi số thật.
+ */
+export const TEMP_SORT_OFFSET = 1_000_000
+
+export function rowsMovingSortOrder<T>(plan: TablePlan<T>): RowChange<T>[] {
+  return plan.updates.filter((c) => c.changedColumns.includes('sort_order'))
+}
diff --git a/scripts/seed/run.ts b/scripts/seed/run.ts
new file mode 100644
index 0000000..49ab8b2
--- /dev/null
+++ b/scripts/seed/run.ts
@@ -0,0 +1,190 @@
+// Lõi của `pnpm seed`: validate → đọc DB → lập kế hoạch → in báo cáo → ghi.
+// Nhận DB qua interface SeedDb, nên test được bằng DB giả trong bộ nhớ.
+
+import { isEmpty, planTable, rowsMovingSortOrder, TEMP_SORT_OFFSET, type TablePlan } from './plan'
+import type { KanjiRow, VocabRow } from './schema'
+import { formatIssue, validateAll, type SeedFiles } from './validate'
+
+export type Row = Record<string, unknown>
+
+export interface SeedDb {
+  /** Đọc mọi dòng của bảng (tự chia trang). */
+  fetchAll(table: string, columns: string[]): Promise<Row[]>
+  /** INSERT ... ON CONFLICT (onConflict) DO UPDATE. */
+  upsert(table: string, rows: Row[], onConflict: string): Promise<void>
+  /** Xoá liên kết vocabulary_kanji thừa (bảng suy ra, không ai tham chiếu). */
+  deleteLinks(links: { vocabulary_id: string; position: number }[]): Promise<void>
+}
+
+export interface SeedOptions {
+  files: SeedFiles
+  /** null = chỉ validate, không đọc/ghi DB (--check). */
+  db: SeedDb | null
+  dryRun: boolean
+  log: (line: string) => void
+}
+
+export interface SeedSummary {
+  ok: boolean
+  kanji?: TablePlan<KanjiRow>
+  vocabularies?: TablePlan<VocabRow>
+  links?: { inserts: number; updates: number; unchanged: number; stale: number }
+  wrote: boolean
+}
+
+const KANJI_COLS = ['character', 'han_viet', 'meaning_vi', 'onyomi', 'kunyomi', 'stroke_count', 'jlpt_level'] as const
+const VOCAB_COLS = ['code', 'sort_order', 'expression', 'reading_kana', 'meaning_vi', 'romaji', 'han_viet', 'is_kana_only', 'jlpt_level'] as const
+
+function printPlan(name: string, plan: TablePlan<Row>, log: (s: string) => void) {
+  log(`  ${name}: ${plan.inserts.length} mới · ${plan.updates.length} sửa · ${plan.unchanged} không đổi`)
+  for (const c of plan.inserts.slice(0, 20)) log(`    + ${c.key}`)
+  if (plan.inserts.length > 20) log(`    … và ${plan.inserts.length - 20} dòng mới khác`)
+  for (const c of plan.updates.slice(0, 50)) log(`    ~ ${c.key}: ${c.changedColumns.join(', ')}`)
+  if (plan.updates.length > 50) log(`    … và ${plan.updates.length - 50} dòng sửa khác`)
+  if (plan.missingInFile.length) {
+    log(`    ! ${plan.missingInFile.length} dòng có trong DB nhưng không còn trong file (KHÔNG xoá): ${plan.missingInFile.slice(0, 10).join(', ')}`)
+  }
+}
+
+function pick(row: Row, cols: readonly string[]): Row {
+  return Object.fromEntries(cols.map((c) => [c, row[c] ?? null]))
+}
+
+export async function runSeed({ files, db, dryRun, log }: SeedOptions): Promise<SeedSummary> {
+  // ---------- 1. Validate toàn bộ ----------
+  const v = validateAll(files)
+  log(`Đọc ${v.kanji.length} Kanji, ${v.vocabularies.length} từ vựng, ${v.links.length} liên kết từ ↔ Kanji.`)
+
+  if (v.warnings.length) {
+    log(`\nCảnh báo (không chặn): ${v.warnings.length}`)
+    for (const w of v.warnings.slice(0, 15)) log(`  - ${formatIssue(w)}`)
+    if (v.warnings.length > 15) log(`  … và ${v.warnings.length - 15} cảnh báo khác`)
+  }
+  if (v.errors.length) {
+    log(`\nLỖI: ${v.errors.length}. Không ghi gì vào database.`)
+    for (const e of v.errors) log(`  ✗ ${formatIssue(e)}`)
+    return { ok: false, wrote: false }
+  }
+  log('\nValidate: OK')
+  if (!db) return { ok: true, wrote: false }
+
+  // ---------- 2. Đọc DB, lập kế hoạch ----------
+  const vocabCols: string[] = [...VOCAB_COLS, ...(v.hasEmojiColumn ? ['emoji'] : [])]
+  const [dbKanji, dbVocab] = await Promise.all([
+    db.fetchAll('kanji', ['id', ...KANJI_COLS]),
+    db.fetchAll('vocabularies', ['id', ...vocabCols]),
+  ])
+
+  const kanjiPlan = planTable(v.kanji as unknown as Row[], dbKanji, (r) => String(r.character), KANJI_COLS)
+  const vocabPlan = planTable(v.vocabularies as unknown as Row[], dbVocab, (r) => String(r.code), vocabCols)
+
+  // Liên kết: chỉ lập được đầy đủ khi biết id. Dòng mới chưa có id → đếm là "mới".
+  const dbLinks = await db.fetchAll('vocabulary_kanji', ['vocabulary_id', 'position', 'kanji_id'])
+  const fileCodes = new Set(v.vocabularies.map((r) => r.code))
+  const linkPlan = planLinks(v.links, fileCodes, dbVocab, dbKanji, dbLinks)
+
+  log('\nKế hoạch:')
+  printPlan('kanji', kanjiPlan, log)
+  printPlan('vocabularies', vocabPlan, log)
+  log(`  vocabulary_kanji: ${linkPlan.inserts} mới · ${linkPlan.updates} sửa · ${linkPlan.unchanged} không đổi · ${linkPlan.stale} thừa sẽ xoá`)
+
+  const summary: SeedSummary = {
+    ok: true,
+    kanji: kanjiPlan as unknown as TablePlan<KanjiRow>,
+    vocabularies: vocabPlan as unknown as TablePlan<VocabRow>,
+    links: { inserts: linkPlan.inserts, updates: linkPlan.updates, unchanged: linkPlan.unchanged, stale: linkPlan.stale },
+    wrote: false,
+  }
+
+  const nothingToDo = isEmpty(kanjiPlan) && isEmpty(vocabPlan) && linkPlan.inserts + linkPlan.updates + linkPlan.stale === 0
+  if (nothingToDo) {
+    log('\nDatabase đã khớp file. Không có gì để ghi.')
+    return summary
+  }
+  if (dryRun) {
+    log('\nDry-run: chưa ghi gì. Chạy `pnpm seed` (không có --dry-run) để ghi.')
+    return summary
+  }
+
+  // ---------- 3. Ghi: kanji → vocabularies → vocabulary_kanji ----------
+  const changed = <T>(p: TablePlan<T>) => [...p.inserts, ...p.updates]
+
+  if (!isEmpty(kanjiPlan)) {
+    await db.upsert('kanji', changed(kanjiPlan).map((c) => pick(c.row, KANJI_COLS)), 'character')
+  }
+
+  if (!isEmpty(vocabPlan)) {
+    const moving = rowsMovingSortOrder(vocabPlan)
+    if (moving.length) {
+      await db.upsert(
+        'vocabularies',
+        moving.map((c) => ({ ...pick(c.row, vocabCols), sort_order: TEMP_SORT_OFFSET + Number(c.row.sort_order) })),
+        'code',
+      )
+    }
+    await db.upsert('vocabularies', changed(vocabPlan).map((c) => pick(c.row, vocabCols)), 'code')
+  }
+
+  // Đọc lại id sau khi ghi (từ / Kanji mới vừa có id)
+  const [kanjiIds, vocabIds, linksNow] = await Promise.all([
+    db.fetchAll('kanji', ['id', 'character']),
+    db.fetchAll('vocabularies', ['id', 'code']),
+    db.fetchAll('vocabulary_kanji', ['vocabulary_id', 'position', 'kanji_id']),
+  ])
+  const finalLinks = planLinks(v.links, fileCodes, vocabIds, kanjiIds, linksNow)
+  if (finalLinks.toUpsert.length) await db.upsert('vocabulary_kanji', finalLinks.toUpsert, 'vocabulary_id,position')
+  if (finalLinks.toDelete.length) await db.deleteLinks(finalLinks.toDelete)
+
+  log('\nĐã ghi xong.')
+  return { ...summary, wrote: true }
+}
+
+// ---------------------------------------------------------------------------
+
+export function planLinks(
+  links: { code: string; position: number; character: string }[],
+  /** code của mọi từ trong file (kể cả từ chỉ có Kana, không có liên kết). */
+  fileCodes: Set<string>,
+  vocabRows: Row[],
+  kanjiRows: Row[],
+  dbLinks: Row[],
+) {
+  const vocabId = new Map(vocabRows.map((r) => [String(r.code), String(r.id)]))
+  const kanjiId = new Map(kanjiRows.map((r) => [String(r.character), String(r.id)]))
+  const existing = new Map(dbLinks.map((r) => [`${r.vocabulary_id}#${r.position}`, String(r.kanji_id)]))
+
+  const desiredKeys = new Set<string>()
+  const toUpsert: { vocabulary_id: string; position: number; kanji_id: string }[] = []
+  let inserts = 0
+  let updates = 0
+  let unchanged = 0
+
+  for (const l of links) {
+    const vid = vocabId.get(l.code)
+    const kid = kanjiId.get(l.character)
+    if (!vid || !kid) {
+      inserts++ // từ hoặc Kanji chưa có trong DB → sẽ tạo sau khi ghi
+      continue
+    }
+    const key = `${vid}#${l.position}`
+    desiredKeys.add(key)
+    const current = existing.get(key)
+    if (current === undefined) inserts++
+    else if (current !== kid) updates++
+    else {
+      unchanged++
+      continue
+    }
+    toUpsert.push({ vocabulary_id: vid, position: l.position, kanji_id: kid })
+  }
+
+  // Chỉ xoá liên kết thừa của những từ còn trong file (vd. sửa expression ít Kanji hơn).
+  // Từ đã biến mất khỏi file giữ nguyên mọi thứ (data-spec §1.4).
+  const vocabInFile = new Set(vocabRows.filter((r) => fileCodes.has(String(r.code))).map((r) => String(r.id)))
+  const toDelete = dbLinks
+    .filter((r) => !desiredKeys.has(`${r.vocabulary_id}#${r.position}`))
+    .filter((r) => vocabInFile.has(String(r.vocabulary_id)))
+    .map((r) => ({ vocabulary_id: String(r.vocabulary_id), position: Number(r.position) }))
+
+  return { inserts, updates, unchanged, stale: toDelete.length, toUpsert, toDelete }
+}
diff --git a/scripts/seed/schema.ts b/scripts/seed/schema.ts
new file mode 100644
index 0000000..ab1c5e4
--- /dev/null
+++ b/scripts/seed/schema.ts
@@ -0,0 +1,181 @@
+// zod schema cho MỘT dòng CSV (data-spec §2, §3).
+// Luật cần nhìn nhiều dòng cùng lúc (trùng code, Hán Việt khớp bảng kanji...)
+// nằm ở validate.ts.
+//
+// Chỉ dùng phần API chung của zod 3 và zod 4 (string, refine, regex, transform,
+// safeParse) để không phụ thuộc phiên bản.
+
+import { z } from 'zod'
+
+// ---------- Ký tự ----------
+export const KANJI_CHAR = /[一-鿿㐀-䶿々〆]/
+export const KANJI_ONLY = /^[一-鿿㐀-䶿]$/
+export const KANA_ONLY = /^[ぁ-ゖァ-ヺー]+$/
+export const KATAKANA = /^[ァ-ヺー]+$/
+export const KUN_READING = /^[ぁ-ゖー.\-]+$/
+
+export function hasKanji(s: string): boolean {
+  return KANJI_CHAR.test(s)
+}
+
+// ---------- Mảnh ghép dùng chung ----------
+/** Ô trong CSV: '' đã được đổi thành null trước khi parse. */
+type Cell = string | null
+
+const required = (label = 'không được rỗng') =>
+  z
+    .string()
+    .nullable()
+    .refine((v): v is string => v !== null, label)
+    .transform((v) => v as string)
+
+/** Không khoảng trắng thừa, không "( x )", không "; ;" (data-spec §7). */
+const tidy = (v: string) =>
+  v === v.trim() &&
+  !v.includes('  ') &&
+  !v.includes('( ') &&
+  !v.includes(' )') &&
+  !/;\s*;/.test(v) &&
+  !/;(?! )/.test(v)
+
+const tidyText = () => required().refine(tidy, 'có khoảng trắng thừa, "( x )", ";;" hoặc ";" không có dấu cách phía sau')
+
+const intIn = (min: number, max: number) =>
+  z
+    .string()
+    .regex(/^\d+$/, 'phải là số nguyên')
+    .transform(Number)
+    .refine((n) => n >= min && n <= max, `phải trong khoảng ${min}–${max}`)
+
+const optionalInt = (min: number, max: number) =>
+  z
+    .string()
+    .nullable()
+    .refine((v) => v === null || /^\d+$/.test(v), 'phải là số nguyên hoặc để trống')
+    .transform((v) => (v === null ? null : Number(v)))
+    .refine((n) => n === null || (n >= min && n <= max), `phải trong khoảng ${min}–${max}`)
+
+/** Cột không bắt buộc: null cho qua, có giá trị thì phải thoả check. */
+const optionalText = (check: (v: string) => boolean, label: string) =>
+  z
+    .string()
+    .nullable()
+    .refine((v) => v === null || check(v), label)
+
+const upperHanViet = (v: string) => v === v.toUpperCase()
+
+/** Mảng Postgres dạng {"イチ","イツ"} hoặc {} → string[]. Trả null nếu sai cú pháp. */
+export function parsePgArray(src: string): string[] | null {
+  if (!src.startsWith('{') || !src.endsWith('}')) return null
+  const inner = src.slice(1, -1)
+  if (inner === '') return []
+  const out: string[] = []
+  let i = 0
+  while (i <= inner.length) {
+    let item = ''
+    if (inner[i] === '"') {
+      i++
+      while (i < inner.length && inner[i] !== '"') {
+        if (inner[i] === '\\') i++
+        item += inner[i++] ?? ''
+      }
+      if (inner[i] !== '"') return null
+      i++
+    } else {
+      while (i < inner.length && inner[i] !== ',') item += inner[i++]
+      item = item.trim()
+    }
+    if (item === '') return null
+    out.push(item)
+    if (i === inner.length) break
+    if (inner[i] !== ',') return null
+    i++
+  }
+  return out
+}
+
+const pgArray = (re: RegExp, label: string) =>
+  required('phải có, dùng {} nếu không có âm nào')
+    .transform((v, ctx) => {
+      const arr = parsePgArray(v)
+      if (arr === null) {
+        ctx.addIssue({ code: 'custom', message: 'sai định dạng mảng Postgres, ví dụ {"ガク"} hoặc {}' })
+        return [] as string[]
+      }
+      return arr
+    })
+    .refine((arr) => arr.every((x) => re.test(x)), label)
+
+// ---------- kanji.csv ----------
+export const KANJI_COLUMNS = ['character', 'han_viet', 'meaning_vi', 'onyomi', 'kunyomi', 'stroke_count', 'jlpt_level'] as const
+
+export const kanjiRowSchema = z.object({
+  character: required().refine((v) => KANJI_ONLY.test(v), 'phải đúng 1 chữ Kanji'),
+  han_viet: tidyText()
+    .refine(upperHanViet, 'phải viết HOA')
+    .refine((v) => !v.includes(' '), 'chỉ một âm, không có dấu cách'),
+  meaning_vi: tidyText(),
+  onyomi: pgArray(KATAKANA, 'âm On phải là Katakana'),
+  kunyomi: pgArray(KUN_READING, 'âm Kun phải là Hiragana (dấu . ngăn okurigana)'),
+  stroke_count: optionalInt(1, 64),
+  jlpt_level: optionalInt(1, 5),
+})
+export type KanjiRow = z.infer<typeof kanjiRowSchema>
+
+// ---------- vocabularies.csv ----------
+export const VOCAB_COLUMNS = [
+  'code',
+  'sort_order',
+  'expression',
+  'reading_kana',
+  'meaning_vi',
+  'romaji',
+  'han_viet',
+  'is_kana_only',
+  'jlpt_level',
+] as const
+/** Cột tuỳ chọn, được phép thêm vào cuối header (DATA-05). */
+export const VOCAB_OPTIONAL_COLUMNS = ['emoji'] as const
+
+export const vocabRowSchema = z
+  .object({
+    code: required().refine((v) => /^n[1-5]-\d{4}$/.test(v), 'phải có dạng n5-0001'),
+    sort_order: intIn(1, 1_000_000),
+    expression: tidyText(),
+    reading_kana: required().refine((v) => KANA_ONLY.test(v), 'chỉ được có Hiragana, Katakana và ー'),
+    meaning_vi: tidyText(),
+    romaji: optionalText((v) => v === v.toLowerCase() && tidy(v), 'phải viết thường, không khoảng trắng thừa'),
+    han_viet: optionalText((v) => tidy(v) && upperHanViet(v), 'phải viết HOA, không khoảng trắng thừa'),
+    is_kana_only: required()
+      .refine((v) => v === 'true' || v === 'false', 'phải là true hoặc false')
+      .transform((v) => v === 'true'),
+    jlpt_level: intIn(1, 5),
+    emoji: optionalText((v) => !/\s/.test(v), 'không được có khoảng trắng').optional(),
+  })
+  .superRefine((row, ctx) => {
+    const kanji = hasKanji(row.expression)
+    if (row.is_kana_only === kanji) {
+      ctx.addIssue({
+        code: 'custom',
+        path: ['is_kana_only'],
+        message: kanji ? 'expression có Kanji nên phải là false' : 'expression không có Kanji nên phải là true',
+      })
+    }
+    if (!row.is_kana_only && row.han_viet === null) {
+      ctx.addIssue({ code: 'custom', path: ['han_viet'], message: 'từ có Kanji bắt buộc có Hán Việt' })
+    }
+    if (row.is_kana_only && row.han_viet !== null) {
+      ctx.addIssue({ code: 'custom', path: ['han_viet'], message: 'từ chỉ có Kana thì để trống Hán Việt' })
+    }
+  })
+export type VocabRow = z.infer<typeof vocabRowSchema>
+
+/** Đổi ô rỗng thành null (data-spec §1.5) trước khi đưa vào schema. */
+export function toCells(header: readonly string[], cells: string[]): Record<string, Cell> {
+  const obj: Record<string, Cell> = {}
+  header.forEach((col, i) => {
+    const v = cells[i] ?? ''
+    obj[col] = v === '' ? null : v
+  })
+  return obj
+}

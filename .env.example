# Chép file này thành .env.local rồi điền giá trị thật. KHÔNG commit .env.local.

# URL project Supabase (Dashboard → Project Settings → API)
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxx.supabase.co

# Chỉ dùng cho `pnpm seed` chạy ở terminal. Bỏ qua RLS → tuyệt đối không có prefix NEXT_PUBLIC_.
# Dashboard → Project Settings → API Keys → secret key (sb_secret_...) hoặc service_role (legacy)
SUPABASE_SERVICE_ROLE_KEY=

# Copy file này thành .env.local rồi điền giá trị thật. KHÔNG commit .env.local.
# Lấy ở Supabase Dashboard → Project Settings → API Keys / Data API.

# Public — được nhúng vào client bundle, an toàn vì mọi truy vấn vẫn qua RLS
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Secret — KHÔNG có prefix NEXT_PUBLIC_, KHÔNG dùng trong app runtime.
# Chỉ dùng cho script seed (pnpm seed) chạy trên máy dev.
SUPABASE_SECRET_KEY=
